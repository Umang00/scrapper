{
  "name": "universal-crawler",
  "version": "1.0.0",
  "private": true,
  "description": "Universal Headless Crawler System - Production-ready web scraping platform",
  "workspaces": [
    "shared",
    "api-server",
    "workers",
    "frontend"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=api-server",
    "dev:worker": "npm run dev --workspace=workers",
    "dev:ui": "npm run dev --workspace=frontend",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "typecheck": "npm run typecheck --workspaces"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "web-scraping",
    "crawler",
    "crawlee",
    "playwright",
    "supabase"
  ],
  "author": "",
  "license": "MIT"
}
