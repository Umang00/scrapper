# Supabase Configuration
SUPABASE_URL=your-project-url.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/crawler_db

# Redis
REDIS_URL=redis://localhost:6379

# AWS S3 (or compatible object storage)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=crawler-artifacts

# Proxy Configuration
PROXY_RESIDENTIAL_URL=http://user:pass@proxy.example.com:8080
PROXY_DATACENTER_URL=http://user:pass@proxy.example.com:8081

# Captcha Solving
# Mode: manual (free, human-in-loop) | auto (paid, 2Captcha) | hybrid (try 2Captcha, fallback to manual)
CAPTCHA_SOLVER_MODE=manual
# 2Captcha API key (required for auto/hybrid modes) - Get from https://2captcha.com
TWOCAPTCHA_API_KEY=
# Max time to wait for captcha solution (milliseconds)
CAPTCHA_TIMEOUT_MS=120000

# Video Transcription
# Enable/disable video transcription (true/false)
ENABLE_TRANSCRIPTION=false
# Transcription mode: 'fast' (YouTube captions only), 'universal' (Vosk for all), 'auto' (try captions first, fallback to Vosk)
TRANSCRIPTION_MODE=auto
# Path to Vosk model directory (download from https://alphacephei.com/vosk/models)
# Recommended: vosk-model-small-en-us-0.15 (40MB) for English
VOSK_MODEL_PATH=./models/vosk-model-small-en-us-0.15

# Platform-specific OAuth/API Tokens
TWITTER_API_KEY=
TWITTER_API_SECRET=
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
YOUTUBE_API_KEY=

# API Server
PORT=3000
NODE_ENV=development

# GitHub (for automation)
GITHUB_TOKEN=

# Security
JWT_SECRET=your-jwt-secret-key
ENCRYPTION_KEY=your-encryption-key-for-credentials
