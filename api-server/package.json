    "typecheck": "tsc --noEmit",
    "test": "vitest"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.81.1",
    "express": "^4.21.2",
    "express-validator": "^7.2.0",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "dotenv": "^16.4.7",
    "winston": "^3.17.0",
    "pg": "^8.13.1",
    "ioredis": "^5.4.2",
    "aws-sdk": "^2.1691.0",
    "zod": "^3.24.1",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^24.0.1",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
