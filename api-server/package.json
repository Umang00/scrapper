{
  "name": "@universal-crawler/api-server",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "REST API server for Universal Crawler",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
